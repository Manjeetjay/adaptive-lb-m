    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Worker JVM heap utilization using the G1 Old Gen pool, whose maximum heap size is a valid finite value in the verified Prometheus output.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Heap %",
            "axisPlacement": "auto",
            "fillOpacity": 20,
